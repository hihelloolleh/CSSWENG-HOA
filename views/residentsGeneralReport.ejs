<%
    const fmtDate = (d) => {
        if (!d) return '—';
        return new Date(d + 'T00:00:00').toLocaleDateString('en-PH', {
            month: 'long', day: 'numeric', year: 'numeric',
        });
    };

    const activeResidents   = residents.filter(r => r.isActive == 1);
    const inactiveResidents = residents.filter(r => r.isActive == 0);
%>

<div class="rpt-actions no-print">
    <a href="/reports" class="rpt-back"><i class="fa-solid fa-arrow-left"></i> Back to Reports</a>
    <div style="display:flex; gap:10px;">
        <button onclick="exportCSV()" class="rpt-print-btn" style="background:#4a7c59;">
            <i class="fa-solid fa-file-csv"></i> Export CSV
        </button>
        <button onclick="window.print()" class="rpt-print-btn">
            <i class="fa-solid fa-print"></i> Print / Save as PDF
        </button>
    </div>
</div>

<div class="rpt-page">

    <h1 class="rpt-main-title">RESIDENTS GENERAL REPORT</h1>

    <div class="rpt-meta">
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT NAME:</span>
            <span>MARCELO GREEN VILLAGE PHASE 5 HOA RESIDENTS GENERAL REPORT</span>
        </div>
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT PERIOD:</span>
            <span>AS OF CURRENT DATE</span>
        </div>
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT GENERATION DATE:</span>
            <span><%= generatedDate %></span>
        </div>
    </div>

    <div class="rpt-summary-box">
        <div class="rpt-summary-label">SUMMARY</div>
        <div class="rpt-summary-row">
            <span class="rpt-summary-key">TOTAL RESIDENTS</span>
            <span class="rpt-summary-val"><%= summary.totalResidents %></span>
            <span class="rpt-summary-breakdown">
                BREAKDOWN: &nbsp; ACTIVE <%= summary.activeResidents %> &nbsp;&nbsp; INACTIVE <%= summary.inactiveResidents %>
            </span>
        </div>
        <div class="rpt-summary-row">
            <span class="rpt-summary-key">TOTAL REGISTERED VEHICLES</span>
            <span class="rpt-summary-val"><%= summary.totalVehicles %></span>
        </div>
    </div>

    <!-- ── SECTION 1: RESIDENTS ─────────────────────────────────────────────── -->
    <h2 class="rpt-section-title">Active Residents</h2>
    <table class="rpt-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Address</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Birth Date</th>
                <th>Contact No.</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            <% if (activeResidents.length === 0) { %>
            <tr><td colspan="8" style="text-align:center;padding:16px;color:#999;">No active residents found.</td></tr>
            <% } else { %>
                <% activeResidents.forEach(r => { %>
                <tr>
                    <td><%= r.full_name %></td>
                    <td><%= r.resident_type %></td>
                    <td><%= r.address %></td>
                    <td><%= fmtDate(r.residency_start_date) %></td>
                    <td><%= fmtDate(r.residency_end_date) %></td>
                    <td><%= fmtDate(r.birth_date) %></td>
                    <td><%= r.contact_num || '—' %></td>
                    <td><%= r.email || '—' %></td>
                </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>

    <h2 class="rpt-section-title" style="margin-top:32px;">Inactive Residents</h2>
    <table class="rpt-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Address</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Birth Date</th>
                <th>Contact No.</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            <% if (inactiveResidents.length === 0) { %>
            <tr><td colspan="8" style="text-align:center;padding:16px;color:#999;">No inactive residents found.</td></tr>
            <% } else { %>
                <% inactiveResidents.forEach(r => { %>
                <tr>
                    <td><%= r.full_name %></td>
                    <td><%= r.resident_type %></td>
                    <td><%= r.address %></td>
                    <td><%= fmtDate(r.residency_start_date) %></td>
                    <td><%= fmtDate(r.residency_end_date) %></td>
                    <td><%= fmtDate(r.birth_date) %></td>
                    <td><%= r.contact_num || '—' %></td>
                    <td><%= r.email || '—' %></td>
                </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>

    <!-- ── SECTION 2: REGISTERED VEHICLES ──────────────────────────────────── -->
    <h2 class="rpt-section-title" style="margin-top:40px;">Registered Vehicles</h2>
    <table class="rpt-table">
        <thead>
            <tr>
                <th>Resident</th>
                <th>Resident Status</th>
                <th>Vehicle Type</th>
                <th>Plate Number</th>
                <th>Make</th>
                <th>Model</th>
                <th>Color</th>
                <th>Sticker Year</th>
                <th>Has Sticker</th>
            </tr>
        </thead>
        <tbody>
            <% if (vehicles.length === 0) { %>
            <tr><td colspan="9" style="text-align:center;padding:16px;color:#999;">No registered vehicles found.</td></tr>
            <% } else { %>
                <% vehicles.forEach(v => { %>
                <tr>
                    <td><%= v.resident_name %></td>
                    <td><%= v.residentIsActive ? 'Active' : 'Inactive' %></td>
                    <td><%= v.type || '—' %></td>
                    <td><%= v.plate_number || '—' %></td>
                    <td><%= v.make || '—' %></td>
                    <td><%= v.model || '—' %></td>
                    <td><%= v.color || '—' %></td>
                    <td><%= v.sticker_year || '—' %></td>
                    <td><%= v.hasSticker ? 'Yes' : 'No' %></td>
                </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>

</div>

<script id="residentsData" type="application/json"><%- JSON.stringify(residents) %></script>
<script id="vehiclesData"  type="application/json"><%- JSON.stringify(vehicles)  %></script>
<script id="summaryData"   type="application/json"><%- JSON.stringify(summary)   %></script>
<script>
function exportCSV() {
    const residents = JSON.parse(document.getElementById('residentsData').textContent);
    const vehicles  = JSON.parse(document.getElementById('vehiclesData').textContent);
    const summary   = JSON.parse(document.getElementById('summaryData').textContent);

    const esc = val => '"' + String(val ?? '').replace(/"/g, '""') + '"';

    const fmtDate = d => {
        if (!d) return '';
        return new Date(d + 'T00:00:00').toLocaleDateString('en-PH', {
            month: 'long', day: 'numeric', year: 'numeric',
        });
    };

    const lines = [];

    // Summary
    lines.push(esc('SUMMARY'));
    lines.push([esc('Metric'), esc('Value')].join(','));
    lines.push([esc('Total Residents'),          esc(summary.totalResidents)].join(','));
    lines.push([esc('Active Residents'),          esc(summary.activeResidents)].join(','));
    lines.push([esc('Inactive Residents'),        esc(summary.inactiveResidents)].join(','));
    lines.push([esc('Total Registered Vehicles'), esc(summary.totalVehicles)].join(','));
    lines.push('');

    // Residents
    const resCols = ['Name','Status','Type','Address','Start Date','End Date','Birth Date','Contact No.','Email'].map(esc).join(',');
    ['Active', 'Inactive'].forEach(label => {
        lines.push(esc(label.toUpperCase() + ' RESIDENTS'));
        lines.push(resCols);
        residents.filter(r => label === 'Active' ? r.isActive == 1 : r.isActive == 0).forEach(r => {
            lines.push([
                esc(r.full_name),
                esc(label),
                esc(r.resident_type),
                esc(r.address),
                esc(fmtDate(r.residency_start_date)),
                esc(fmtDate(r.residency_end_date)),
                esc(fmtDate(r.birth_date)),
                esc(r.contact_num),
                esc(r.email),
            ].join(','));
        });
        lines.push('');
    });

    // Vehicles
    lines.push(esc('REGISTERED VEHICLES'));
    lines.push(['Resident','Resident Status','Vehicle Type','Plate Number','Make','Model','Color','Sticker Year','Has Sticker'].map(esc).join(','));
    vehicles.forEach(v => {
        lines.push([
            esc(v.resident_name),
            esc(v.residentIsActive ? 'Active' : 'Inactive'),
            esc(v.type),
            esc(v.plate_number),
            esc(v.make),
            esc(v.model),
            esc(v.color),
            esc(v.sticker_year),
            esc(v.hasSticker ? 'Yes' : 'No'),
        ].join(','));
    });

    const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href     = url;
    a.download = 'residents_general_report.csv';
    a.click();
    URL.revokeObjectURL(url);
}
</script>

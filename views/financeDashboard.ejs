<%
    const fmt = (n) => {
        const num = parseFloat(n) || 0;
        if (num >= 1000000) return '₱' + (num / 1000000).toFixed(2) + 'M';
        if (num >= 1000)    return '₱' + (num / 1000).toFixed(1)    + 'K';
        return '₱' + num.toFixed(2);
    };
%>

<div class="main-wrapper">
    <div class="sidebar-open nav-item">
        <i class="fa-solid fa-bars"></i>
        <span>Open Sidebar</span>
    </div>

    <header class="topbar">
        <div class="topbar-left">
            <h1 class="page-title">Finance Dashboard</h1>
        </div>
        <div class="topbar-right">
            <div class="topbar-user">
                <div class="user-avatar">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div class="user-info">
                    <span class="user-name">Village Admin</span>
                    <span class="user-role">Administrator</span>
                </div>
            </div>
        </div>
    </header>

    <main class="content">
        <section class="finance-header">
            <div class="finance-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search transactions..." id="transactionSearch">
            </div>

            <div class="finance-actions">
                <button onclick="window.location.href='/payments';" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i>&nbsp; Add Payment
                </button>
            </div>
        </section>

        <!-- Date range filter -->
        <div class="fd-filter-bar">
            <form id="dateFilterForm" method="GET" action="/finances">
                <label>From</label>
                <input type="date" id="fdFrom" name="from" value="<%= fromDate %>" class="fd-date-input">
                <label>To</label>
                <input type="date" id="fdTo"   name="to"   value="<%= toDate %>"   class="fd-date-input">
                <button type="submit" class="fd-apply-btn">Apply</button>
                <span class="fd-period-label">
                    Showing: <strong><%= fromDateDisplay %></strong> — <strong><%= toDateDisplay %></strong>
                </span>
                <span id="fdErr" class="fd-err" style="display:none;"></span>
            </form>
        </div>

        <section class="finance-summary">
            <div class="card finance-card">
                <div class="finance-card-content">
                    <p class="finance-card-title">Total Collected (Period)</p>
                    <h2 class="finance-card-value"><%= fmt(stats.periodCollected) %></h2>
                </div>
                <div class="finance-card-icon green">
                    <i class="ph ph-trend-up"></i>
                </div>
            </div>

            <div class="card finance-card">
                <div class="finance-card-content">
                    <p class="finance-card-title">Total Uncollected (Period)</p>
                    <h2 class="finance-card-value"><%= fmt(stats.periodUncollected) %></h2>
                </div>
                <div class="finance-card-icon red">
                    <i class="ph ph-trend-down"></i>
                </div>
            </div>

            <div class="card finance-card">
                <div class="finance-card-content">
                    <p class="finance-card-title">Outstanding Dues</p>
                    <h2 class="finance-card-value"><%= fmt(stats.outstandingDues) %></h2>
                </div>
                <div class="finance-card-icon red">
                    <i class="ph ph-warning"></i>
                </div>
            </div>
        </section>

        <section class="summary-cards row2">
            <div class="card stat-card">
                <div class="stat-icon green"><i class="fa-solid fa-money-bill-trend-up"></i></div>
                <div class="stat-info">
                    <span class="stat-value"><%= fmt(stats.periodCollected) %></span>
                    <span class="stat-label">Total Collected</span>
                </div>
            </div>
            <div class="card stat-card">
                <div class="stat-icon yellow"><i class="fa-solid fa-hand-holding-dollar"></i></div>
                <div class="stat-info">
                    <span class="stat-value"><%= fmt(stats.periodUncollected) %></span>
                    <span class="stat-label">Total Uncollected</span>
                </div>
            </div>
            <div class="card stat-card">
                <div class="stat-icon red"><i class="fa-solid fa-clock-rotate-left"></i></div>
                <div class="stat-info">
                    <span class="stat-value"><%= stats.pendingCount %></span>
                    <span class="stat-label">Pending Payments</span>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="card-header">
                <h2>Transactions in Period</h2>
                <a href="/payments" class="view-all">View All →</a>
            </div>

            <table class="data-table" id="transactionsTable">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Resident</th>
                        <th>Purpose</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (recentTransactions.length === 0) { %>
                        <tr>
                            <td colspan="5" style="text-align:center; color:#aaa; padding:24px;">No transactions in this period.</td>
                        </tr>
                    <% } else { %>
                        <% recentTransactions.forEach(tx => {
                            const paid     = parseFloat(tx.amount_paid)     || 0;
                            const expected = parseFloat(tx.amount_expected)  || 0;
                            let status = 'Unpaid', cls = 'status-unpaid';
                            if (paid >= expected && paid > 0) { status = 'Paid';    cls = 'status-paid'; }
                            else if (paid > 0)                { status = 'Partial'; cls = 'status-partial'; }
                            const dateFmt = tx.date_paid
                                ? new Date(tx.date_paid + 'T00:00:00').toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' })
                                : '—';
                        %>
                        <tr>
                            <td><%= dateFmt %></td>
                            <td>
                                <strong><%= tx.payer_name || '—' %></strong><br>
                                <small><%= tx.address || '—' %></small>
                            </td>
                            <td><%= tx.purpose %></td>
                            <td>₱<%= paid.toLocaleString('en-PH', { minimumFractionDigits: 2 }) %></td>
                            <td><span class="payment-status <%= cls %>"><%= status %></span></td>
                        </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </section>
    </main>
</div>

<script src="/js/sidebar.js"></script>
<script>
// ── Transaction search ────────────────────────────────────────────────────────
document.getElementById('transactionSearch').addEventListener('input', function () {
    const q = this.value.toLowerCase();
    document.querySelectorAll('#transactionsTable tbody tr').forEach(row => {
        row.style.display = !q || row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
});

// ── Date filter validation ────────────────────────────────────────────────────
(function () {
    const today  = new Date().toISOString().slice(0, 10);
    const fromEl = document.getElementById('fdFrom');
    const toEl   = document.getElementById('fdTo');
    const errEl  = document.getElementById('fdErr');

    fromEl.max = today;
    toEl.max   = today;

    fromEl.addEventListener('change', function () {
        toEl.min = this.value;
        errEl.style.display = 'none';
    });

    toEl.addEventListener('change', function () {
        fromEl.max = this.value < today ? this.value : today;
        errEl.style.display = 'none';
    });

    document.getElementById('dateFilterForm').addEventListener('submit', function (e) {
        const from = fromEl.value, to = toEl.value;
        if (!from || !to) {
            e.preventDefault();
            errEl.textContent = 'Both dates are required.';
            errEl.style.display = 'inline';
            return;
        }
        if (from > today || to > today) {
            e.preventDefault();
            errEl.textContent = 'Dates cannot be in the future.';
            errEl.style.display = 'inline';
            return;
        }
        if (from > to) {
            e.preventDefault();
            errEl.textContent = '"From" date cannot be after "To" date.';
            errEl.style.display = 'inline';
        }
    });
})();
</script>

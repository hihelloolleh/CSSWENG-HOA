<%
    const activeRows   = rows.filter(r => r.isActive == 1);
    const inactiveRows = rows.filter(r => r.isActive == 0);

    const groupByResident = (arr) => {
        const map = new Map();
        arr.forEach(r => {
            if (!map.has(r.resident_id)) {
                map.set(r.resident_id, {
                    full_name: r.full_name,
                    address:   r.address,
                    vehicles:  [],
                });
            }
            if (r.vehicle_id !== null) {
                map.get(r.resident_id).vehicles.push({
                    type:         r.type,
                    plate_number: r.plate_number,
                    make:         r.make,
                    model:        r.model,
                    color:        r.color,
                    sticker_year: r.sticker_year,
                    hasSticker:   r.hasSticker,
                });
            }
        });
        return Array.from(map.values());
    };

    const activeResidents   = groupByResident(activeRows);
    const inactiveResidents = groupByResident(inactiveRows);
%>

<div class="rpt-actions no-print">
    <a href="/reports" class="rpt-back"><i class="fa-solid fa-arrow-left"></i> Back to Reports</a>
    <div style="display:flex; gap:10px;">
        <button onclick="exportCSV()" class="rpt-print-btn" style="background:#4a7c59;">
            <i class="fa-solid fa-file-csv"></i> Export CSV
        </button>
        <button onclick="window.print()" class="rpt-print-btn">
            <i class="fa-solid fa-print"></i> Print / Save as PDF
        </button>
    </div>
</div>

<div class="rpt-page">

    <h1 class="rpt-main-title">RESIDENT VEHICLE STICKER REPORT</h1>

    <div class="rpt-meta">
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT NAME:</span>
            <span>MARCELO GREEN VILLAGE PHASE 5 HOA RESIDENT VEHICLE STICKER REPORT</span>
        </div>
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT PERIOD:</span>
            <span>AS OF CURRENT DATE</span>
        </div>
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT GENERATION DATE:</span>
            <span><%= generatedDate %></span>
        </div>
    </div>

    <div class="rpt-summary-box">
        <div class="rpt-summary-label">SUMMARY</div>
        <div class="rpt-summary-row">
            <span class="rpt-summary-key">TOTAL RESIDENTS</span>
            <span class="rpt-summary-val"><%= summary.totalResidents %></span>
            <span class="rpt-summary-breakdown">
                BREAKDOWN: &nbsp; ACTIVE <%= summary.activeResidents %> &nbsp;&nbsp; INACTIVE <%= summary.inactiveResidents %>
            </span>
        </div>
        <div class="rpt-summary-row">
            <span class="rpt-summary-key">TOTAL REGISTERED VEHICLES</span>
            <span class="rpt-summary-val"><%= summary.totalVehicles %></span>
        </div>
    </div>

    <!-- ACTIVE RESIDENTS -->
    <h2 class="rpt-section-title">Active Residents</h2>
    <table class="rpt-table">
        <thead>
            <tr>
                <th>Resident Name</th>
                <th>Address</th>
                <th>Vehicle Type</th>
                <th>Plate Number</th>
                <th>Make / Model</th>
                <th>Color</th>
                <th>Sticker Year</th>
                <th>Has Sticker</th>
            </tr>
        </thead>
        <tbody>
            <% if (activeResidents.length === 0) { %>
            <tr>
                <td colspan="8" style="text-align:center;padding:16px;color:#999;">No active residents found.</td>
            </tr>
            <% } else { %>
                <% activeResidents.forEach(resident => { %>
                    <% const vCount = Math.max(resident.vehicles.length, 1); %>
                    <% if (resident.vehicles.length === 0) { %>
                    <tr>
                        <td style="font-weight:600;"><%= resident.full_name %></td>
                        <td><%= resident.address %></td>
                        <td colspan="6" style="color:#aaa;">No registered vehicles</td>
                    </tr>
                    <% } else { %>
                        <% resident.vehicles.forEach((v, idx) => { %>
                        <tr>
                            <% if (idx === 0) { %>
                            <td rowspan="<%= vCount %>" style="vertical-align:top;font-weight:600;"><%= resident.full_name %></td>
                            <td rowspan="<%= vCount %>" style="vertical-align:top;"><%= resident.address %></td>
                            <% } %>
                            <td><%= v.type || '—' %></td>
                            <td><%= v.plate_number || '—' %></td>
                            <td><%= [v.make, v.model].filter(Boolean).join(' ') || '—' %></td>
                            <td><%= v.color || '—' %></td>
                            <td><%= v.sticker_year || '—' %></td>
                            <td><%= v.hasSticker ? 'Yes' : 'No' %></td>
                        </tr>
                        <% }) %>
                    <% } %>
                <% }) %>
            <% } %>
        </tbody>
    </table>

    <!-- INACTIVE RESIDENTS -->
    <h2 class="rpt-section-title" style="margin-top:32px;">Inactive Residents</h2>
    <table class="rpt-table">
        <thead>
            <tr>
                <th>Resident Name</th>
                <th>Address</th>
                <th>Vehicle Type</th>
                <th>Plate Number</th>
                <th>Make / Model</th>
                <th>Color</th>
                <th>Sticker Year</th>
                <th>Has Sticker</th>
            </tr>
        </thead>
        <tbody>
            <% if (inactiveResidents.length === 0) { %>
            <tr>
                <td colspan="8" style="text-align:center;padding:16px;color:#999;">No inactive residents found.</td>
            </tr>
            <% } else { %>
                <% inactiveResidents.forEach(resident => { %>
                    <% const vCount = Math.max(resident.vehicles.length, 1); %>
                    <% if (resident.vehicles.length === 0) { %>
                    <tr>
                        <td style="font-weight:600;"><%= resident.full_name %></td>
                        <td><%= resident.address %></td>
                        <td colspan="6" style="color:#aaa;">No registered vehicles</td>
                    </tr>
                    <% } else { %>
                        <% resident.vehicles.forEach((v, idx) => { %>
                        <tr>
                            <% if (idx === 0) { %>
                            <td rowspan="<%= vCount %>" style="vertical-align:top;font-weight:600;"><%= resident.full_name %></td>
                            <td rowspan="<%= vCount %>" style="vertical-align:top;"><%= resident.address %></td>
                            <% } %>
                            <td><%= v.type || '—' %></td>
                            <td><%= v.plate_number || '—' %></td>
                            <td><%= [v.make, v.model].filter(Boolean).join(' ') || '—' %></td>
                            <td><%= v.color || '—' %></td>
                            <td><%= v.sticker_year || '—' %></td>
                            <td><%= v.hasSticker ? 'Yes' : 'No' %></td>
                        </tr>
                        <% }) %>
                    <% } %>
                <% }) %>
            <% } %>
        </tbody>
    </table>

</div>

<script id="reportRowsData" type="application/json"><%- JSON.stringify(rows) %></script>
<script id="reportSummaryData" type="application/json"><%- JSON.stringify(summary) %></script>
<script>
function exportCSV() {
    const rows    = JSON.parse(document.getElementById('reportRowsData').textContent);
    const summary = JSON.parse(document.getElementById('reportSummaryData').textContent);

    const esc = val => '"' + String(val ?? '').replace(/"/g, '""') + '"';

    const lines = [];

    lines.push(esc('SUMMARY'));
    lines.push([esc('Metric'), esc('Value')].join(','));
    lines.push([esc('Total Residents'),           esc(summary.totalResidents)].join(','));
    lines.push([esc('Active Residents'),           esc(summary.activeResidents)].join(','));
    lines.push([esc('Inactive Residents'),         esc(summary.inactiveResidents)].join(','));
    lines.push([esc('Total Registered Vehicles'),  esc(summary.totalVehicles)].join(','));
    lines.push('');

    const cols = ['Resident Name', 'Status', 'Address', 'Vehicle Type', 'Plate Number', 'Make', 'Model', 'Color', 'Sticker Year', 'Has Sticker'].map(esc).join(',');

    ['Active', 'Inactive'].forEach(label => {
        lines.push(esc(label.toUpperCase() + ' RESIDENTS'));
        lines.push(cols);
        rows.filter(r => label === 'Active' ? r.isActive == 1 : r.isActive == 0).forEach(r => {
            lines.push([
                esc(r.full_name),
                esc(label),
                esc(r.address),
                esc(r.vehicle_id ? r.type         : ''),
                esc(r.vehicle_id ? r.plate_number  : ''),
                esc(r.vehicle_id ? r.make          : ''),
                esc(r.vehicle_id ? r.model         : ''),
                esc(r.vehicle_id ? r.color         : ''),
                esc(r.vehicle_id ? r.sticker_year  : ''),
                esc(r.vehicle_id ? (r.hasSticker ? 'Yes' : 'No') : ''),
            ].join(','));
        });
        lines.push('');
    });

    const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href     = url;
    a.download = 'resident_vehicle_sticker_report.csv';
    a.click();
    URL.revokeObjectURL(url);
}
</script>

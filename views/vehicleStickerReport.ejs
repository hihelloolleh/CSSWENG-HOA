<%
    const currency = (n) => {
        const num = parseFloat(n) || 0;
        return '₱' + num.toLocaleString('en-PH', { minimumFractionDigits: 2 });
    };

    const fmtDate = (dateStr) => {
        if (!dateStr) return '—';
        return new Date(dateStr).toLocaleDateString('en-PH', {
            month: 'long', day: 'numeric', year: 'numeric',
        });
    };
%>

<div class="rpt-actions no-print">
    <a href="/reports" class="rpt-back"><i class="fa-solid fa-arrow-left"></i> Back to Reports</a>
    
    <div style="display:flex; gap:10px; margin-left: auto;">
        <button onclick="exportCSV()" class="rpt-print-btn" style="background:#4a7c59;">
            <i class="fa-solid fa-file-csv"></i> Export CSV
        </button>
        <button onclick="window.print()" class="rpt-print-btn">
            <i class="fa-solid fa-print"></i> Print / Save as PDF
        </button>
    </div>
</div>

<div class="rpt-page">

    <h1 class="rpt-main-title">VEHICLE STICKERS SALES REPORT</h1>

    <div class="rpt-meta">
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT NAME:</span>
            <span>MARCELO GREEN VILLAGE PHASE 5 - VEHICLE STICKER SALES REPORT</span>
        </div>
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT PERIOD:</span>
            <span>AS OF CURRENT DATE</span>
        </div>
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT GENERATION DATE:</span>
            <span><%= generatedDate %></span>
        </div>
    </div>

    <div class="rpt-summary-box">
        <div class="rpt-summary-label">SUMMARY</div>
        <div class="rpt-summary-row">
            <span class="rpt-summary-key">TOTAL AMOUNT EARNED FROM VEHICLE STICKERS</span>
            <span class="rpt-summary-val"><%= currency(summary.totalEarnings) %></span>
        </div>
        <div class="rpt-summary-row">
            <span class="rpt-summary-key">TOTAL NUMBER OF STICKERS SOLD</span>
            <span class="rpt-summary-val"><%= summary.totalCount %></span>
        </div>
    </div>

    <div class="rpt-summary-box" style="margin-top: 20px;">
        <div class="rpt-summary-label">BREAKDOWN</div>
        <div class="rpt-summary-row">
            <span class="rpt-summary-key">CARS</span>
            <span class="rpt-summary-val"><%= summary.cars || 0 %></span>
        </div>
        <div class="rpt-summary-row">
            <span class="rpt-summary-key">MOTORCYCLES</span>
            <span class="rpt-summary-val"><%= summary.motorcycles || 0 %></span>
        </div>
        <div class="rpt-summary-row">
            <span class="rpt-summary-key">E-BIKES</span>
            <span class="rpt-summary-val"><%= summary.ebikes || 0 %></span>
        </div>
        <div class="rpt-summary-row">
            <span class="rpt-summary-key">COMMERCIAL</span>
            <span class="rpt-summary-val"><%= summary.commercial || 0 %></span>
        </div>
    </div>

</div>

<script id="reportRowsData"    type="application/json"><%- JSON.stringify(rows)    %></script>
<script id="reportSummaryData" type="application/json"><%- JSON.stringify(summary) %></script>

<script>
function exportCSV() {
    const rows    = JSON.parse(document.getElementById('reportRowsData').textContent);
    const summary = JSON.parse(document.getElementById('reportSummaryData').textContent);

    const esc = val => '"' + String(val ?? '').replace(/"/g, '""') + '"';

    const fmtDate = dateStr => {
        if (!dateStr) return '';
        return new Date(dateStr).toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' });
    };

    const lines = [];

    lines.push(esc('SUMMARY'));
    lines.push([esc('Metric'), esc('Value')].join(','));
    lines.push([esc('Total Stickers Issued'), esc(summary.totalCount)].join(','));
    lines.push([esc('Total Earnings'),        esc(parseFloat(summary.totalEarnings).toFixed(2))].join(','));
    lines.push('');

    lines.push(esc('VEHICLE STICKER TRANSACTIONS'));
    lines.push(['Date Paid', 'Amount Paid', 'Payment Method', 'Receipt Number', 'Remarks'].map(esc).join(','));
    
    rows.forEach(r => {
        lines.push([
            esc(fmtDate(r.date_paid)),
            esc(parseFloat(r.amount_paid || 0).toFixed(2)),
            esc(r.payment_method),
            esc(r.receipt_number),
            esc(r.remarks)
        ].join(','));
    });

    const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href     = url;
    a.download = `Vehicle_Stickers_Report.csv`;
    a.click();
    URL.revokeObjectURL(url);
}
</script>
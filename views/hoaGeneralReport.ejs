<%
    const fmtDate = dateStr => {
        if (!dateStr) return '—';
        return new Date(dateStr).toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' });
    };
%>

<div class="rpt-actions no-print">
    <a href="/reports" class="rpt-back"><i class="fa-solid fa-arrow-left"></i> Back to Reports</a>
    <div style="display:flex; gap:10px;">
        <button onclick="exportCSV()" class="rpt-print-btn" style="background:#4a7c59;">
            <i class="fa-solid fa-file-csv"></i> Export CSV
        </button>
        <button onclick="window.print()" class="rpt-print-btn">
            <i class="fa-solid fa-print"></i> Print / Save as PDF
        </button>
    </div>
</div>

<div class="rpt-page">

    <h1 class="rpt-main-title">HOA GENERAL DETAILS REPORT</h1>

    <div class="rpt-meta">
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT NAME:</span>
            <span>MARCELO GREEN VILLAGE PHASE 5 HOA GENERAL DETAILS REPORT</span>
        </div>
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT PERIOD:</span>
            <span>AS OF CURRENT DATE</span>
        </div>
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT GENERATION DATE:</span>
            <span><%= generatedDate %></span>
        </div>
    </div>

    <!-- SUMMARY -->
    <div class="rpt-summary-box">
        <div class="rpt-summary-label">SUMMARY</div>

        <div class="rpt-summary-row">
            <span class="rpt-summary-key">TOTAL PROPERTIES</span>
            <span class="rpt-summary-val"><%= properties.total %></span>
            <span class="rpt-summary-breakdown">
                BREAKDOWN: &nbsp; HOUSE <%= properties.houseCount %> &nbsp;&nbsp; LOT <%= properties.lotCount %>
                &nbsp;&nbsp; | &nbsp;&nbsp; DELINQUENT <%= properties.delinquent %>
            </span>
        </div>

        <div class="rpt-summary-row">
            <span class="rpt-summary-key">TOTAL ACTIVE RESIDENTS</span>
            <span class="rpt-summary-val"><%= residents.totalActive %></span>
            <span class="rpt-summary-breakdown">
                BREAKDOWN: &nbsp; HOMEOWNERS <%= residents.homeownerCount %> &nbsp;&nbsp; TENANTS <%= residents.tenantCount %>
            </span>
        </div>

        <div class="rpt-summary-row">
            <span class="rpt-summary-key">CURRENT BOARD MEMBERS</span>
            <span class="rpt-summary-val"><%= boardMembers.length %></span>
        </div>

        <div class="rpt-summary-row">
            <span class="rpt-summary-key">TOTAL EMPLOYEES</span>
            <span class="rpt-summary-val"><%= employees.length %></span>
        </div>
    </div>

    <!-- BOARD MEMBERS -->
    <h2 class="rpt-section-title">Current Board Members</h2>
    <table class="rpt-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Position</th>
                <th>Term Start</th>
                <th>Contact Number</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            <% if (boardMembers.length === 0) { %>
            <tr>
                <td colspan="5" style="text-align:center;padding:16px;color:#999;">No current board members found.</td>
            </tr>
            <% } else { %>
                <% boardMembers.forEach(bm => { %>
                <tr>
                    <td><%= bm.full_name %></td>
                    <td><%= bm.position %></td>
                    <td><%= fmtDate(bm.board_start_date) %></td>
                    <td><%= bm.contact_num || '—' %></td>
                    <td><%= bm.email || '—' %></td>
                </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>

    <!-- EMPLOYEES -->
    <h2 class="rpt-section-title" style="margin-top:32px;">Employees</h2>
    <table class="rpt-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Position</th>
                <th>Contact Number</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            <% if (employees.length === 0) { %>
            <tr>
                <td colspan="4" style="text-align:center;padding:16px;color:#999;">No employees found.</td>
            </tr>
            <% } else { %>
                <% employees.forEach(emp => { %>
                <tr>
                    <td><%= emp.full_name %></td>
                    <td><%= emp.position %></td>
                    <td><%= emp.contact_num || '—' %></td>
                    <td><%= emp.email || '—' %></td>
                </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>

</div>

<script id="boardMembersData" type="application/json"><%- JSON.stringify(boardMembers) %></script>
<script id="employeesData"    type="application/json"><%- JSON.stringify(employees)    %></script>
<script id="propertiesData"   type="application/json"><%- JSON.stringify(properties)   %></script>
<script id="residentsData"    type="application/json"><%- JSON.stringify(residents)    %></script>
<script>
function exportCSV() {
    const boardMembers = JSON.parse(document.getElementById('boardMembersData').textContent);
    const employees    = JSON.parse(document.getElementById('employeesData').textContent);
    const properties   = JSON.parse(document.getElementById('propertiesData').textContent);
    const residents    = JSON.parse(document.getElementById('residentsData').textContent);

    const esc = val => '"' + String(val ?? '').replace(/"/g, '""') + '"';

    const fmtDate = dateStr => {
        if (!dateStr) return '';
        return new Date(dateStr).toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' });
    };

    const lines = [];

    // Summary section
    lines.push(esc('SUMMARY'));
    lines.push([esc('Metric'), esc('Value'), esc('Detail')].join(','));
    lines.push([esc('Total Properties'),     esc(properties.total),         esc(`House: ${properties.houseCount}, Lot: ${properties.lotCount}, Delinquent: ${properties.delinquent}`)].join(','));
    lines.push([esc('Total Active Residents'), esc(residents.totalActive),  esc(`Homeowners: ${residents.homeownerCount}, Tenants: ${residents.tenantCount}`)].join(','));
    lines.push([esc('Current Board Members'), esc(boardMembers.length),     esc('')].join(','));
    lines.push([esc('Total Employees'),       esc(employees.length),        esc('')].join(','));
    lines.push('');

    // Board members section
    lines.push(esc('CURRENT BOARD MEMBERS'));
    lines.push([esc('Name'), esc('Position'), esc('Term Start'), esc('Contact Number'), esc('Email')].join(','));
    boardMembers.forEach(bm => {
        lines.push([
            esc(bm.full_name),
            esc(bm.position),
            esc(fmtDate(bm.board_start_date)),
            esc(bm.contact_num || ''),
            esc(bm.email || '')
        ].join(','));
    });
    lines.push('');

    // Employees section
    lines.push(esc('EMPLOYEES'));
    lines.push([esc('Name'), esc('Position'), esc('Contact Number'), esc('Email')].join(','));
    employees.forEach(emp => {
        lines.push([
            esc(emp.full_name),
            esc(emp.position),
            esc(emp.contact_num || ''),
            esc(emp.email || '')
        ].join(','));
    });

    const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href     = url;
    a.download = 'hoa_general_details_report.csv';
    a.click();
    URL.revokeObjectURL(url);
}
</script>

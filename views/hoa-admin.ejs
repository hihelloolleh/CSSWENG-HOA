<!-- ============================================================
     HOA ADMIN CONTACT VIEW
     Layout: views/layouts/auth.ejs (no sidebar)
     Route:  GET /hoa-admin  (routes/index.js)
     Pulls live contact info from the Admin table, kept in sync
     with the "Update Contact Info" form on Account Management.
     ============================================================ -->
<link rel="stylesheet" href="/css/hoa-admin.css">

<div class="hoa-admin-container">
    <h1>HOA Admin</h1>

    <div class="contact-info">
        <p>If you are having trouble logging in, please contact the HOA Admin at:</p>

        <div class="email">
            <label>Email:</label>
            <span><%= adminContact.email || 'Not yet configured' %></span>
        </div>

        <div class="phone">
            <label>Phone:</label>
            <span><%= adminContact.contact_num || 'Not yet configured' %></span>
        </div>
    </div>

    <a href="/login" class="back-button">Back to Login</a>
</div>
